{
  "rules": {
    ".read": false,
    ".write": false,
    "games": {
      "$code": {
        ".read": "$code.length === 6 && (!data.exists() || data.child('createdAt').val() > now - 172800000)",
        ".write": "$code.length === 6"
      }
    },
    "photos": {
      "$code": {
        ".read": false,
        ".write": "$code.length === 6",
        "$id": { ".read": "$code.length === 6 && root.child('games').child($code).child('createdAt').val() > now - 172800000" }
      }
    },
    "index": {
      "$key": {
        ".read": "$key.length === 64",
        ".write": "$key.length === 64"
      }
    }
  }
}
