{
  "rules": {
    ".read": false,
    ".write": false,
    "games": {
      "$code": {
        ".read": "$code.length === 6",
        ".write": "$code.length === 6"
      }
    },
    "photos": {
      "$code": {
        ".read": false,
        ".write": "$code.length === 6",
        "$id": { ".read": "$code.length === 6" }
      }
    },
    "index": {
      "$key": {
        ".read": "$key.length === 64",
        ".write": "$key.length === 64"
      }
    }
  }
}
